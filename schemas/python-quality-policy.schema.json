{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "smells python policy v2 (registry validation also required)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_pack",
    "scanner_version",
    "scope",
    "exclude_directories",
    "limits",
    "rules",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "rule_pack": {
      "const": "python-v1"
    },
    "scanner_version": {
      "const": "0.1.0"
    },
    "scope": {
      "const": "authored_source"
    },
    "exclude_directories": {
      "type": "array",
      "uniqueItems": true,
      "contains": {
        "const": ".git"
      },
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^/\\\\]+$",
        "not": {
          "enum": [
            ".",
            ".."
          ]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_files",
        "maximum_pairs",
        "maximum_group_combinations"
      ],
      "properties": {
        "maximum_files": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_pairs": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_group_combinations": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rules": {
      "type": "object",
      "minProperties": 28,
      "maxProperties": 28,
      "propertyNames": {
        "enum": [
          "python.function_lines",
          "python.function_arguments",
          "python.class_fields",
          "python.class_methods",
          "python.class_method_lines",
          "python.primitive_slots",
          "python.data_clumps",
          "python.alternative_interfaces",
          "python.repeated_dispatch",
          "python.temporary_fields",
          "python.comment_share",
          "python.duplicate_functions",
          "python.data_class",
          "python.lazy_class",
          "python.forwarding_share",
          "python.function_crap",
          "python.unused_code",
          "python.unused_type_parameters",
          "python.nominal_slot_contract",
          "python.port_conformance",
          "python.refused_bequest",
          "python.divergent_change",
          "python.parallel_inheritance",
          "python.shotgun_surgery",
          "python.foreign_accesses",
          "python.dependency_contract",
          "python.library_capabilities",
          "python.navigation_chains"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/selection"
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "parameters"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "required",
            "report",
            "off"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "patternProperties": {
            "percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "basis_points": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "^minimum_": {
              "type": "integer",
              "minimum": 1
            }
          },
          "properties": {
            "minimum_group_size": {
              "minimum": 2
            },
            "minimum_tokens": {
              "minimum": 4
            }
          }
        }
      }
    }
  }
}
