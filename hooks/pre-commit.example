#!/bin/sh
# Inactive example. Validate and pin the scanner before installing it in a project.
set -eu

if ! command -v smells >/dev/null 2>&1; then
    printf '%s\n' 'smells: required scanner executable is unavailable' >&2
    exit 2
fi

# JSON is intentional: agentic coding environments need the complete actionable
# finding, including source evidence and the mandatory reference-research gate.
exec smells check --staged --policy quality-policy.json --format json
