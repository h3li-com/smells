{
  "schema_version": 2,
  "rule_pack": "rust-v1",
  "scanner_version": "0.3.0",
  "scope": "authored_all_cfg",
  "default_groups": ["all"],
  "exclude_directories": [
    ".cache",
    ".git",
    ".mypy_cache",
    ".next",
    ".pnpm-store",
    ".pytest_cache",
    ".ruff_cache",
    ".tox",
    ".uv-cache",
    ".venv",
    "__pycache__",
    "coverage",
    "node_modules",
    "target"
  ],
  "limits": {"maximum_files": 10000, "maximum_pairs": 100000, "maximum_group_combinations": 100000},
  "rules": {
    "rust.function_lines": {"version":1,"mode":"required","parameters":{"maximum":100}},
    "rust.function_arguments": {"version":1,"mode":"required","parameters":{"maximum":7}},
    "rust.type_fields": {"version":1,"mode":"required","parameters":{"maximum":15}},
    "rust.enum_variants": {"version":1,"mode":"required","parameters":{"maximum":20}},
    "rust.type_functions": {"version":1,"mode":"required","parameters":{"maximum":20}},
    "rust.type_function_lines": {"version":1,"mode":"required","parameters":{"maximum":500}},
    "rust.trait_functions": {"version":1,"mode":"required","parameters":{"maximum":20}},
    "rust.primitive_slots": {"version":1,"mode":"report","parameters":{"minimum_raw_slots":5,"minimum_share_percent":80}},
    "rust.data_clumps": {"version":1,"mode":"report","parameters":{"minimum_group_size":3,"minimum_declarations":3}},
    "rust.alternative_interfaces": {"version":1,"mode":"report","parameters":{"minimum_similarity_basis_points":8200,"minimum_tokens":20}},
    "rust.repeated_dispatch": {"version":1,"mode":"report","parameters":{"minimum_sites":3,"minimum_arms":4}},
    "rust.temporary_fields": {"version":1,"mode":"report","parameters":{"minimum_fields":3,"minimum_methods":4,"maximum_use_percent":25}},
    "rust.comment_share": {"version":1,"mode":"report","parameters":{"minimum_code_lines":20,"minimum_share_percent":30}},
    "rust.duplicate_functions": {"version":1,"mode":"report","parameters":{"minimum_similarity_basis_points":8200,"minimum_tokens":20}},
    "rust.data_class": {"version":1,"mode":"report","parameters":{"minimum_fields":2,"maximum_operations":0}},
    "rust.lazy_class": {"version":1,"mode":"report","parameters":{"maximum_fields":1,"maximum_functions":1,"maximum_lines":5}},
    "rust.forwarding_share": {"version":1,"mode":"report","parameters":{"minimum_methods":5,"minimum_share_percent":80}},
    "rust.function_crap": {"version":1,"mode":"report","parameters":{"maximum":5}},
    "rust.unused_code": {"version":1,"mode":"report","parameters":{"maximum_findings":0}},
    "rust.unused_type_parameters": {"version":1,"mode":"report","parameters":{"maximum_findings":0}},
    "rust.nominal_slot_contract": {"version":1,"mode":"report","parameters":{"maximum_mismatches":0}},
    "rust.port_conformance": {"version":1,"mode":"report","parameters":{"maximum_failures":0}},
    "rust.divergent_change": {"version":1,"mode":"report","parameters":{"minimum_changes":3,"minimum_responsibilities":3}},
    "rust.shotgun_surgery": {"version":1,"mode":"report","parameters":{"maximum_owners":3}},
    "rust.foreign_accesses": {"version":1,"mode":"report","parameters":{"minimum_foreign_accesses":5,"minimum_share_percent_exclusive":60}},
    "rust.dependency_contract": {"version":1,"mode":"report","parameters":{"maximum_forbidden_accesses":0}},
    "rust.library_capabilities": {"version":1,"mode":"report","parameters":{"maximum_failures":0}},
    "rust.navigation_chains": {"version":1,"mode":"report","parameters":{"minimum_transitions":3}}
  },
  "exceptions": []
}
