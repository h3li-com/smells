{
  "schema_version": 2,
  "rule_pack": "python-v1",
  "scanner_version": "0.1.0",
  "scope": "authored_source",
  "exclude_directories": [
    ".cache",
    ".git",
    ".mypy_cache",
    ".next",
    ".pnpm-store",
    ".pytest_cache",
    ".ruff_cache",
    ".tox",
    ".uv-cache",
    ".venv",
    "__pycache__",
    "coverage",
    "node_modules",
    "target"
  ],
  "limits": {
    "maximum_files": 10000,
    "maximum_pairs": 250000,
    "maximum_group_combinations": 100000
  },
  "rules": {
    "python.function_lines": {
      "version": 1,
      "mode": "required",
      "parameters": {
        "maximum": 100
      }
    },
    "python.function_arguments": {
      "version": 1,
      "mode": "required",
      "parameters": {
        "maximum": 7
      }
    },
    "python.class_fields": {
      "version": 1,
      "mode": "required",
      "parameters": {
        "maximum": 15
      }
    },
    "python.class_methods": {
      "version": 1,
      "mode": "required",
      "parameters": {
        "maximum": 20
      }
    },
    "python.class_method_lines": {
      "version": 1,
      "mode": "required",
      "parameters": {
        "maximum": 500
      }
    },
    "python.primitive_slots": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "minimum_raw_slots": 5,
        "minimum_share_percent": 80
      }
    },
    "python.data_clumps": {
      "version": 1,
      "mode": "report",
      "parameters": {
        "minimum_group_size": 3,
        "minimum_declarations": 3
      }
    },
    "python.alternative_interfaces": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "minimum_similarity_basis_points": 8200,
        "minimum_tokens": 20
      }
    },
    "python.repeated_dispatch": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "minimum_sites": 3,
        "minimum_arms": 4
      }
    },
    "python.temporary_fields": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "minimum_fields": 3,
        "minimum_methods": 4,
        "maximum_use_percent": 25
      }
    },
    "python.comment_share": {
      "version": 1,
      "mode": "report",
      "parameters": {
        "minimum_code_lines": 20,
        "minimum_share_percent": 30
      }
    },
    "python.duplicate_functions": {
      "version": 1,
      "mode": "report",
      "parameters": {
        "minimum_similarity_basis_points": 8200,
        "minimum_tokens": 20
      }
    },
    "python.data_class": {
      "version": 1,
      "mode": "report",
      "parameters": {
        "minimum_fields": 2,
        "maximum_operations": 0
      }
    },
    "python.lazy_class": {
      "version": 1,
      "mode": "report",
      "parameters": {
        "maximum_fields": 1,
        "maximum_functions": 1,
        "maximum_lines": 5
      }
    },
    "python.forwarding_share": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "minimum_methods": 5,
        "minimum_share_percent": 80
      }
    },
    "python.function_crap": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "maximum": 30
      }
    },
    "python.unused_code": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "maximum_findings": 0
      }
    },
    "python.unused_type_parameters": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "maximum_findings": 0
      }
    },
    "python.nominal_slot_contract": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "maximum_mismatches": 0
      }
    },
    "python.port_conformance": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "maximum_failures": 0
      }
    },
    "python.refused_bequest": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "minimum_inherited_members": 3,
        "minimum_unused_percent": 80
      }
    },
    "python.divergent_change": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "minimum_changes": 3,
        "minimum_responsibilities": 3
      }
    },
    "python.parallel_inheritance": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "minimum_parallel_pairs": 3
      }
    },
    "python.shotgun_surgery": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "maximum_owners": 3
      }
    },
    "python.foreign_accesses": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "minimum_foreign_accesses": 5,
        "minimum_share_percent_exclusive": 60
      }
    },
    "python.dependency_contract": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "maximum_forbidden_accesses": 0
      }
    },
    "python.library_capabilities": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "maximum_failures": 0
      }
    },
    "python.navigation_chains": {
      "version": 1,
      "mode": "off",
      "parameters": {
        "minimum_transitions": 3
      }
    }
  },
  "exceptions": []
}
